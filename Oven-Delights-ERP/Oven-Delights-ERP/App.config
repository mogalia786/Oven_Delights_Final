<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="OvenDelightsERPConnectionString" 
         connectionString="Server=tcp:mogalia.database.windows.net,1433;Initial Catalog=Oven_Delights_Main;Persist Security Info=False;User ID=faroq786;Password=Faroq#786;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=5;" 
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Gmail SMTP settings: update SmtpUser and SmtpPassword with your Gmail/app password -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="your.gmail.account@gmail.com" />
    <add key="SmtpPassword" value="YOUR_APP_PASSWORD" />
    <add key="SmtpFrom" value="your.gmail.account@gmail.com" />
    <add key="SmtpUseSsl" value="true" />
    <!-- Default recipients for supplier credit note notifications (comma-separated) -->
    <add key="CreditNoteEmailTo" value="ap@ovendelights.com" />
    <!-- Dashboard refresh interval (seconds). Default used if missing/invalid: 60 seconds -->
    <add key="DashboardRefreshSeconds" value="60" />
    
    <!-- FNB Banking API Configuration -->
    <!-- SANDBOX TESTING - Use these credentials for testing -->
    <add key="FNB_Environment" value="Sandbox" />
    <add key="FNB_API_BaseUrl" value="https://api.i.fnb.co.za/apigateway" />
    <add key="FNB_Auth_Url" value="https://api.i.fnb.co.za/apigateway/oauth2/token/v2" />
    <add key="FNB_Statement_BaseUrl" value="https://api.i.fnb.co.za/apigateway/statement/v1" />
    <add key="FNB_ClientId" value="E84OOE" />
    <add key="FNB_ClientSecret" value="621NZsDknRDWjqf8sKhyH0ktjPXtbsr4" />
    <!-- FNB Test Account Details -->
    <add key="FNB_Test_AccountNumber" value="63001723469" />
    <add key="FNB_Test_BranchCode" value="250655" />
    <add key="FNB_Test_BIC" value="FIRNZAJJ" />
    <!-- FNB Test Email for Proof of Payment (POP) -->
    <add key="FNB_Test_POP_Email" value="tshepo.kgasoane@rmb.co.za" />
    <!-- Option 2: Leave credentials blank and use CSV import for manual statement uploads -->
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SqlClient" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.6.1.5" newVersion="4.6.1.5" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
